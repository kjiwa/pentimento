# Regenerate with: sh demo/record.sh
Output demo/pentimento.gif

Require pentimento

Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 800
Set Theme "Builtin Dark"
Set TypingSpeed 40ms

Type "pentimento backfill"
Enter
Sleep 1500ms

Type "pentimento list"
Enter
Sleep 2500ms

Type "pentimento list --starred"
Enter
Sleep 2000ms

Type "pentimento list --tag auth"
Enter
Sleep 2000ms

Type "pentimento tree"
Enter
Sleep 3000ms

Type "pentimento check"
Enter
Sleep 2500ms
